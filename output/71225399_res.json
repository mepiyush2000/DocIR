    {
      "block_label": "paragraph_title",
      "block_content": "1. Prevention of Underage Use of Tobacco Products",
      "block_bbox": [
        300,
        2172,
        1366,
        2232
      ],
      "block_id": 11,
      "block_order": 12,
      "group_id": 11,
      "block_polygon_points": [
        [
          300.0,
          2172.0
        ],
        [
          1366.0,
          2172.0
        ],
        [
          1366.0,
          2232.0
        ],
        [
          300.0,
          2232.0
        ]
      ]
    },
    {
      "block_label": "text",
      "block_content": "The proposed resolution strikes at the core problem of underage consumption of tobacco products. The Food & Drug Administration (\u201cFDA\u201d) and other public health authorities have concluded that virtually all new consumers of tobacco products are under legal age. The proposed resolution attempts to cure what the FDA has termed a \u201cpediatric disease\u201d by drastically curtailing advertising and marketing practices that have been criticized as appealing to minors; by imposing strict controls restricting the sale of tobacco products to adult consumers only; and by requiring dramatic reductions in the levels of underage use, with the tobacco",
      "block_bbox": [
        300,
        2271,
        2040,
        2664
      ],
      "block_id": 12,
      "block_order": 13,
      "group_id": 12,
      "block_polygon_points": [
        [
          300.0,
          2271.0
        ],
        [
          2040.0,
          2271.0
        ],
        [
          2040.0,
          2664.0
        ],
        [
          300.0,
          2664.0
        ]
      ]
    },
