    },
    {
      "block_label": "figure_title",
      "block_content": "Aggregate of 27-nm hepatitis A antigen particles coated with antibody (X188,000)",
      "block_bbox": [
        1418,
        1488,
        2253,
        1557
      ],
      "block_id": 12,
      "block_order": null,
      "group_id": 12,
      "block_polygon_points": [
        [
